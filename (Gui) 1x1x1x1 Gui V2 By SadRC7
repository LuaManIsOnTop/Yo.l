local function XKKI_fake_script() -- Ambient.Script 
	local script = Instance.new('Script', Ambient)

	local lighting = game:GetService("Lighting")
	local button = script.Parent -- GUI Button
	local isRed = false
	
	local function toggleRedAmbient()
		if isRed then
			lighting.Ambient = Color3.new(1, 1, 1) -- Normal light
		else
			lighting.Ambient = Color3.new(1, 0, 0) -- Red light
		end
		isRed = not isRed
	end
	
	button.MouseButton1Click:Connect(toggleRedAmbient) -- Connect to button click
	
end
coroutine.wrap(XKKI_fake_script)()
